# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# VITE_API_BASE_URL: URL kết nối tới Backend NodeJS + Express của BIN (Module 9, 16)
VITE_API_BASE_URL="http://localhost:5000/api"

# VITE_RPC_URL: URL kết nối tới Blockchain RPC (Sepolia/Hardhat Local) của CÔNG (Module 12, 14)
VITE_RPC_URL="https://rpc.sepolia.org"

# VITE_CHAIN_ID: ID Mạng lưới hỗ trợ (11155111 cho Sepolia, 31337 cho Hardhat Local)
VITE_CHAIN_ID="11155111"

# ─── Backend (Express Server) ─────────────────────────────────────────────────
# Cổng server lắng nghe
PORT=5000

# Môi trường chạy: development | production | test
NODE_ENV=development

# Cho phép CORS từ frontend origin
CORS_ORIGIN=http://localhost:3000

# Rate limiting: thời gian cửa sổ (ms) và số request tối đa
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Blockchain RPC (server-side)
RPC_URL=https://rpc.sepolia.org
CHAIN_ID=11155111

# Prefix cho tất cả API routes
API_PREFIX=/api
